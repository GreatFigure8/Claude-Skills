<?xml version="1.0" encoding="UTF-8"?>
<!--
  Opt-in launchd agent for dev-epic-workflow unattended intake.

  NOT installed by install.sh: scheduling is a per-machine choice, and this
  agent runs an agent. Load it deliberately or not at all.

  The credential is NOT in this file and must never be. Files in
  ~/Library/LaunchAgents/ are world-readable; the token lives in
  ~/.config/claude-intake/env at mode 0600, which the runner sources itself.

  Install:
    cp <skill>/assets/claude-config/launchd/com.jonathanstevenson.unattended-intake.plist \
       ~/Library/LaunchAgents/
    # edit ProgramArguments below to point at your checkout, then:
    launchctl load ~/Library/LaunchAgents/com.jonathanstevenson.unattended-intake.plist

  Remove:
    launchctl unload ~/Library/LaunchAgents/com.jonathanstevenson.unattended-intake.plist
    rm ~/Library/LaunchAgents/com.jonathanstevenson.unattended-intake.plist

  Runs only while the Mac is awake and the user is logged in. That is accepted:
  the interactive /intake path always works regardless.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jonathanstevenson.unattended-intake</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jonathanstevenson/Source/claude-skills/Skills/dev-epic-workflow/assets/claude-config/bin/unattended-intake.sh</string>
  </array>

  <!-- Every 30 minutes. Raise it rather than lower it: each run that finds a
       labelled issue spends subscription usage. -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <false/>

  <!-- launchd's PATH is minimal by design; the runner resolves git/gh/claude
       by absolute path, so this is a safety net rather than a dependency. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/jonathanstevenson/.config/claude-intake/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jonathanstevenson/.config/claude-intake/launchd.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
