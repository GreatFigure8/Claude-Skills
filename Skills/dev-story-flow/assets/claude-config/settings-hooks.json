{
  "$comment": "dev-story-flow executor control plane + context budget gate (own copies, no dependency on dev-epic-workflow or dev-story-sprint). Merge the statusLine and hooks keys into ~/.claude/settings.json. Scripts live in ~/.claude/hooks/ and must be executable. PreToolUse/Stop/Subagent* hooks are fast no-ops unless a story-item-executor subagent is active.",
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/hooks/statusline.sh"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/handoff-stop-gate.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/cancel-gate.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/context-budget-gate.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/subagent-lifecycle.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/subagent-lifecycle.sh"
          }
        ]
      }
    ]
  }
}
